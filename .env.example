CAREEROPS_GMAIL_READONLY_MAX_RESULTS=100
CAREEROPS_GMAIL_READONLY_POLL_SECONDS=5
CAREEROPS_MAILBOX_BROKER_SOCKET=/run/careerops-gmail/broker.sock
CAREEROPS_GMAIL_SEND_BROKER_SOCKET=/run/careerops-gmail-send/broker.sock
CAREEROPS_GMAIL_SEND_ATTACHMENT_BROKER_SOCKET=/run/careerops-gmail-send/attachments.sock
CAREEROPS_GMAIL_SEND_LIMIT=10
CAREEROPS_GMAIL_SEND_POLL_SECONDS=5
CAREEROPS_GREENHOUSE_SUBMIT_CREDENTIAL_BROKER_SOCKET=/run/careerops-greenhouse/broker.sock
CAREEROPS_GREENHOUSE_SUBMIT_ATTACHMENT_BROKER_SOCKET=/run/careerops-greenhouse/attachments.sock
CAREEROPS_GREENHOUSE_SUBMIT_LIMIT=10
CAREEROPS_GREENHOUSE_SUBMIT_POLL_SECONDS=5
CAREEROPS_READINESS_TIMEOUT_SECONDS=1.0
CAREEROPS_CONSOLE_ALLOWED_HOSTS=["127.0.0.1:8000","localhost:8000"]
CAREEROPS_CONSOLE_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
CAREEROPS_CONSOLE_COOKIE_SECURE=false
CAREEROPS_STORAGE_ROOT=data/objects
CAREEROPS_STORAGE_MAX_OBJECT_BYTES=10485760
CAREEROPS_MODEL_PROVIDER=disabled
CAREEROPS_GOOGLE_OAUTH_ENABLED=false
CAREEROPS_GOOGLE_OAUTH_IN_PRODUCTION_ATTESTED=false
CAREEROPS_EXTERNAL_WRITES_ENABLED=false
CAREEROPS_AUTO_SEND_ENABLED=false
