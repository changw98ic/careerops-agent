CAREEROPS_POSTGRES_PORT=55432
CAREEROPS_REDIS_PORT=56379
CAREEROPS_TEMPORAL_PORT=7233
CAREEROPS_TEMPORAL_UI_PORT=8233
CAREEROPS_DATABASE_URL=postgresql+psycopg://careerops_runtime:replace-with-disposable-runtime-password@127.0.0.1:55432/careerops
CAREEROPS_DATABASE_ROLE=api
CAREEROPS_DB_OWNER_USER=careerops_owner
CAREEROPS_DB_OWNER_PASSWORD=replace-with-disposable-owner-password
