CAREEROPS_TEMPORAL_DB_USER=temporal_runtime
CAREEROPS_TEMPORAL_DB_PASSWORD=replace-with-disposable-temporal-password
CAREEROPS_TEMPORAL_DB_NAME=temporal
CAREEROPS_TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility
CAREEROPS_TEMPORAL_ADDRESS=127.0.0.1:7233
CAREEROPS_TEMPORAL_NAMESPACE=default
CAREEROPS_TEMPORAL_TASK_QUEUE=careerops-m0
CAREEROPS_CRAWLER_WORKSPACE_ROOT=.
CAREEROPS_CRAWLER_OUTBOX_LIMIT=10
CAREEROPS_CRAWLER_OUTBOX_LEASE_SECONDS=30
CAREEROPS_CRAWLER_OUTBOX_POLL_SECONDS=5
CAREEROPS_CRAWLER_OUTBOX_MAX_ATTEMPTS=3
CAREEROPS_SUBMISSION_OUTBOX_LIMIT=10
CAREEROPS_SUBMISSION_OUTBOX_LEASE_SECONDS=30
CAREEROPS_SUBMISSION_OUTBOX_POLL_SECONDS=5
CAREEROPS_SUBMISSION_OUTBOX_MAX_ATTEMPTS=3
