CAREEROPS_DB_RUNTIME_PASSWORD=replace-with-disposable-runtime-password
CAREEROPS_DB_WORKFLOW_USER=careerops_workflow_runtime
CAREEROPS_DB_WORKFLOW_PASSWORD=replace-with-disposable-workflow-password
CAREEROPS_DB_OUTBOX_USER=careerops_crawler_outbox
CAREEROPS_DB_OUTBOX_PASSWORD=replace-with-disposable-outbox-password
CAREEROPS_DB_MAILBOX_USER=careerops_mailbox_runtime
CAREEROPS_DB_MAILBOX_PASSWORD=replace-with-disposable-mailbox-password
CAREEROPS_DB_MAIL_SENDER_USER=careerops_mail_sender_runtime
CAREEROPS_DB_MAIL_SENDER_PASSWORD=replace-with-disposable-mail-sender-password
CAREEROPS_DB_GREENHOUSE_SENDER_USER=careerops_greenhouse_sender_runtime
CAREEROPS_DB_GREENHOUSE_SENDER_PASSWORD=replace-with-disposable-greenhouse-sender-password
