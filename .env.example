CAREEROPS_ENVIRONMENT=development
CAREEROPS_DEPLOYMENT_MODE=loopback
CAREEROPS_BIND_HOST=127.0.0.1
CAREEROPS_BIND_PORT=8000
CAREEROPS_FRONTEND_PORT=5173
CAREEROPS_DATABASE_URL=postgresql+psycopg://careerops_runtime@127.0.0.1:5432/careerops
CAREEROPS_DATABASE_ROLE=api
CAREEROPS_REDIS_URL=redis://127.0.0.1:6379/0
CAREEROPS_TEMPORAL_ADDRESS=127.0.0.1:7233
CAREEROPS_TEMPORAL_NAMESPACE=default
CAREEROPS_TEMPORAL_TASK_QUEUE=careerops-m0
CAREEROPS_READINESS_TIMEOUT_SECONDS=1.0
CAREEROPS_CONSOLE_ALLOWED_HOSTS='["127.0.0.1:8000","localhost:8000"]'
CAREEROPS_CONSOLE_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]'
CAREEROPS_CONSOLE_COOKIE_SECURE=false
CAREEROPS_STORAGE_ROOT=data/objects
CAREEROPS_STORAGE_MAX_OBJECT_BYTES=10485760
# Real model provider — power-on default for the single-user autonomous loop.
# Any Anthropic-compatible endpoint works (Xiaomi MiMo, Zhipu GLM, OpenAI,
# Anthropic, etc.). Fill in the three credentials below; the app fail-fasts at
# startup if model_provider != 'disabled' and any of them is empty. Set
# CAREEROPS_MODEL_PROVIDER=disabled to opt out without credentials.
CAREEROPS_MODEL_PROVIDER=anthropic-compat
CAREEROPS_MODEL_BASE_URL=
CAREEROPS_MODEL_API_KEY=
CAREEROPS_MODEL_NAME=
CAREEROPS_MODEL_TAILORING_ENABLED=true
CAREEROPS_SMART_INTAKE_ENABLED=false
CAREEROPS_GOOGLE_OAUTH_ENABLED=false
CAREEROPS_EXTERNAL_WRITES_ENABLED=false
CAREEROPS_AUTO_SEND_ENABLED=false
CAREEROPS_DB_RETENTION_USER=careerops_retention_runtime
CAREEROPS_DB_RETENTION_PASSWORD=replace-me
