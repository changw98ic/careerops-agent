# Browser session exports can contain reusable authentication cookies.
frontend/cookies.txt

# Tool/runtime state (not project code)
.omc/
.qoder/
.codegraph/
.claude/
.codex/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
