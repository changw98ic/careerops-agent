.DS_Store
.env
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Private evaluation material is referenced by manifests, never committed.
datasets/private/
datasets/raw/
datasets/holdout/
datasets/derived/

# Local Goal orchestration state is runtime metadata, not source.
.omx/

# Runtime state and decrypted/temporary secrets.
data/
secrets/
*.log

# Google OAuth downloads must be imported into Keychain, never committed.
client_secret_*.json
*.apps.googleusercontent.com.json
