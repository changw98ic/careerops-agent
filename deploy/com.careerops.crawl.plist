<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.careerops.crawl</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/ORICO/career/scripts/crawl_daily.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Volumes/ORICO/career/data/crawl_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/ORICO/career/data/crawl_launchd.log</string>
    <key>WorkingDirectory</key>
    <string>/Volumes/ORICO/career</string>
</dict>
</plist>
