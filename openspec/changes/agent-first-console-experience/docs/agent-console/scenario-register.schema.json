{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerops.local/schemas/agent-console/scenario-register.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_count", "scenarios"],
  "properties": {
    "schema_version": {"const": "scenario-register-v1"},
    "scenario_count": {"const": 106},
    "scenarios": {
      "type": "array",
      "minItems": 106,
      "maxItems": 106,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "requirement", "gate", "command", "owner", "route", "viewports", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^(AO|AR|LL|CL)-(M1|R[1-9])-S[1-9][0-9]*$"},
          "source": {"type": "string", "pattern": "^specs/[a-z0-9-]+/spec\\.md$"},
          "requirement": {"type": "string", "pattern": "^(M1|R[1-9])$"},
          "gate": {"enum": ["API-01", "DB-01", "TEMP-01", "MODEL-01", "CRAWL-01", "CRAWL-02", "UX-01", "A11Y-01", "OPS-01"]},
          "command": {"type": "string", "minLength": 1, "maxLength": 256},
          "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "route": {"type": ["string", "null"], "maxLength": 160},
          "viewports": {"type": ["array", "null"], "items": {"enum": ["1440x900", "375x812"]}},
          "evidence": {"type": "string", "pattern": "^artifacts/(ego|agent-console)/[A-Z]{2}-(M1|R[1-9])-S[1-9][0-9]*\\.json$"}
        }
      }
    }
  }
}
